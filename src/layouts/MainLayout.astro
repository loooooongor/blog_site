---
import Base from "./BaseLayout.astro";
import NavBar from "../components/NavBar.astro";
import Banner from "../components/Banner.astro";

import YukinaConfig from "../../yukina.config";
import Footer from "../components/Footer.astro";
import LeftSideBar from "../components/LeftSideBar.astro";

export interface Props {
  title?: string;
  subTitle?: string;
  bannerImage?: string;
  slug?: string;
}

const props = Astro.props;
---

<Base>
  <NavBar />

  {
    (YukinaConfig.bannerStyle == "LOOP" || YukinaConfig.bannerStyle == "STATIC") && (
      <Banner
        title={props.title}
        subTitle={props.subTitle}
        bannerImage={props.bannerImage}
        slug={props.slug}
      />
    )
  }

  <div class="main-container my-10">
    <div class="flex flex-row items-start space-x-4">
      <!-- Left Sidebar -->
      <div class="left-side-bar">
        <LeftSideBar />
      </div>
      <div class="transition-leaving w-full space-y-8">
        <main class="content onload-animation">
          <slot />
        </main>
        <Footer />
      </div>
    </div>
  </div>
</Base>

<style>
  .main-container {
    @apply mx-auto w-full max-w-[var(--page-width-xl)] px-4 md:px-6 lg:px-0;
    @apply md:min-w-[80%] md:max-w-[80%];
    @apply lg:min-w-[var(--page-width-lg)] lg:max-w-[var(--page-width-lg)];
    @apply xl:min-w-[var(--page-width-xl)] xl:max-w-[var(--page-width-xl)];
  }

  .left-side-bar {
    @apply hidden min-w-[248px] xl:block;
  }

  .content {
    @apply xl:w-[calc(var(--page-width-xl)-264px)];
  }
</style>